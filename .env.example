# Combined production variables for the single Vercel Services project.
# Import actual values through Vercel Settings > Environment Variables.
# Local development still uses client/.env and server/.env.
VITE_API_URL=/api
VITE_USE_SAMPLE_SETTINGS=false
NODE_ENV=production
MONGODB_URI=REPLACE_WITH_PRODUCTION_MONGODB_URI
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
CLIENT_ORIGIN=https://YOUR_PROJECT.vercel.app
TEAM_MIN_SIZE=2
TEAM_MAX_SIZE=4
