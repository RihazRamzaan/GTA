{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/handler.js": {
      "includeFiles": "server/src/**"
    }
  },
  "routes": [
    { "src": "/api(?:/.*)?", "dest": "/api/handler" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
